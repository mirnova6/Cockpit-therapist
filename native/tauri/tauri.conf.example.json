{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit",
  "version": "0.6.0",
  "identifier": "app.cockpit.therapist",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      { "title": "Cockpit", "width": 1280, "height": 860, "minWidth": 390 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://api.anthropic.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Medical",
    "shortDescription": "Local-first therapist clinical workspace",
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": {}
  },
  "plugins": {
    "//": "fs + keyring commands are implemented in src-tauri; connect-src intentionally excludes remote hosts except explicitly-approved AI endpoints."
  }
}
